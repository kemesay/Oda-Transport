# CRA only injects REACT_APP_-prefixed vars — this was previously named
# GOOGLE_MAPS_API_KEY (without the prefix) and silently never reached the
# app; the 3 call sites read a hardcoded literal instead. Now wired for real.
REACT_APP_GOOGLE_MAPS_API_KEY=AIzaSyAgAp1RwiIqCyZZg63gsmyP6TZBuVxw_8c
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
# REACT_APP_PAYMENT_PROVIDER=square
# REACT_APP_BACKEND_API=http://localhost:5100
REACT_APP_BACKEND_API=https://api.odatransportation.com
REACT_APP_PAYMENT_PROVIDER=square

# Square client (public IDs only — never put access token in the browser)
