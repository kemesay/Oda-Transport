# =============================================================================
# ODA Ride (React) — environment template
# Copy to `.env` and fill values. See src/config/squareCredentials.js
# Master template: ../square.env.example
# =============================================================================

REACT_APP_BACKEND_API=http://localhost:5100
REACT_APP_PAYMENT_PROVIDER=square

# Socket.IO (must match backend SOCKET_IO_PATH)
REACT_APP_SOCKET_IO_PATH=/api/v1/socket.io
# REACT_APP_SOCKET_URL=https://api.odatransportation.com

# Square client (public IDs only — never put access token in the browser)
REACT_APP_SQUARE_ENV=sandbox

REACT_APP_SQUARE_SANDBOX_APPLICATION_ID=sandbox-sq0idb-3FtfRZJZuhx76hDTMmWWpA
REACT_APP_SQUARE_SANDBOX_LOCATION_ID=LDM77465MQARF

# REACT_APP_SQUARE_PRODUCTION_APPLICATION_ID=sq0idp-xxxxxxxx
# REACT_APP_SQUARE_PRODUCTION_LOCATION_ID=

# Legacy fallbacks (optional)
# REACT_APP_SQUARE_APPLICATION_ID=
# REACT_APP_SQUARE_LOCATION_ID=

# EmailJS (contact forms)
REACT_APP_EMAILJS_SERVICE_ID=your_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key
