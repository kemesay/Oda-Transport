# Example Nginx for api.odatransportation.com (Node on port 5100)
# Socket.IO path must match backend SOCKET_IO_PATH (default /api/v1/socket.io)

upstream oda_api {
    server 127.0.0.1:5100;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name api.odatransportation.com;

    # ssl_certificate ...;
    # ssl_certificate_key ...;

    client_max_body_size 20M;

    location / {
        proxy_pass http://oda_api;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for Socket.IO (polling + websocket)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering off;
    }
}
